                </mxCell>
                <mxCell id="ndb2" value="&lt;b&gt;account.asset_id&lt;/b&gt; → FK financial_asset&lt;br&gt;&lt;i&gt;V84 — nullable, remplace account.ticker (dropped)&lt;/i&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="200" width="260" height="100" as="geometry"/>
