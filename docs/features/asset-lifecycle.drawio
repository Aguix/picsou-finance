<mxfile host="65bd71144e">
    <diagram name="Cycle de vie d&#39;un asset" id="asset-lifecycle-diagram">
        <mxGraphModel dx="509" dy="2207" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="nTitle" value="Cycle de vie d&#39;un asset — Picsou Finance&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal&quot;&gt;Import CSV → résolution CoinGecko → mapping → schéma FK → fetch récurrent des prix → consommateurs&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1a1a1a;" parent="1" vertex="1">
                    <mxGeometry x="40" y="-70" width="1400" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="nLegend" value="Légende — rectangle bleu = méthode/classe · losange jaune = décision opérateur · cylindre vert = table BDD · rectangle orange = déclencheur frontend (5 min) · trait plein = flux principal · trait pointillé = lecture/écriture indirecte" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="-60" width="740" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="nH1" value="PHASE 1 — Import CSV : détection &amp; résolution d&#39;un asset inconnu" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="nH2" value="Schéma BDD — FK asset_id (migrations V84 / V85)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="20" width="400" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="nH3" value="Wallet Sync — déclencheur parallèle&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-style:italic;font-size:11px&quot;&gt;(source d&#39;assets inconnus, elle aussi)&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1480" y="20" width="400" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="nH4" value="PHASE 2 — Exécution de l&#39;import &amp; persistance" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="420" width="900" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="nH9" value="Mapping standalone (hors import CSV)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1480" y="800" width="400" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="nH5" value="PHASE 3 — Fetch récurrent des prix&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-style:italic;font-size:11px&quot;&gt;Deux déclencheurs distincts coexistent : cron backend (horaire) vs refetch frontend (5 min)&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="940" width="900" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="nH6" value="Adaptateurs de prix (PriceRouter)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="940" width="400" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="nH7" value="Persistance &amp; cache" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="1360" width="400" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="nH8" value="PHASE 4 — Consommateurs" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" parent="1" vertex="1">
