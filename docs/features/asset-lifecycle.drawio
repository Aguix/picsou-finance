                <mxCell id="n5" value="&lt;b&gt;Opérateur choisit (UI)&lt;/b&gt;&lt;br&gt;ImportAssetChoice → &lt;b&gt;MAP&lt;/b&gt; / &lt;b&gt;WORTHLESS&lt;/b&gt; / &lt;b&gt;IGNORE&lt;/b&gt;&lt;br&gt;&lt;i&gt;→ ImportAssetMapping(symbol, action, coingeckoId)&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
