                <mxCell id="ndb3" value="&lt;b&gt;price_snapshot.asset_id&lt;/b&gt; → FK financial_asset&lt;br&gt;&lt;i&gt;V85 — NOT NULL, unique(asset_id,date), remplace price_snapshot.ticker (dropped)&lt;/i&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
