                </mxCell>
                <mxCell id="trH" value="Trade Republic — deux solutions d&#39;import&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-style:italic;font-size:11px&quot;&gt;(sync WebSocket avec holdings vs CSV soldes seuls — source d&#39;assets inconnus, comme Wallet Sync)&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1920" y="20" width="400" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="trA1" value="&lt;b&gt;Déclencheur TR Sync&lt;/b&gt;&lt;br&gt;TradeRepublicController.sync() (manuel) ou completeAuth() → thread background&lt;br&gt;ou SchedulerService.dailyBankSync() (cron 8h) → resyncIfSessionActive()&lt;br&gt;&lt;i&gt;→ TradeRepublicSyncService.syncWithToken(...)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1920" y="90" width="400" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="trA2" value="&lt;b&gt;TradeRepublicPort.fetchAccounts(sessionToken)&lt;/b&gt;&lt;br&gt;&lt;i&gt;TradeRepublicAdapter — WebSocket ; positions en ISIN brut (TrPosition)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1920" y="220" width="400" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="trA3" value="&lt;b&gt;upsertAccount(data, memberId, replaceHoldings=true)&lt;/b&gt;&lt;br&gt;&lt;i&gt;crée/màj Account + accountService.upsertSnapshot() [table: account, balance_snapshot]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1920" y="340" width="400" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="trA4" value="&lt;b&gt;OpenFigiIsinConverter.resolve(isin)&lt;/b&gt;&lt;br&gt;&lt;i&gt;ISIN → ticker Yahoo (ex. IE00BYVQ9F29 → IWDA.AS) ; si ISIN crypto TR (préfixe XF000…) → FinancialAssetService.resolveCrypto(symbol)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1920" y="470" width="400" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="trA5" value="&lt;b&gt;HoldingDedup.vwapMerge(prev, next)&lt;/b&gt;&lt;br&gt;&lt;i&gt;plusieurs ISIN → même ticker : fusion en mémoire (quantité + moyenne pondérée) avant toute résolution FinancialAsset&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1920" y="610" width="400" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="trA6" value="&lt;b&gt;FinancialAssetService.getOrCreate(ticker)&lt;/b&gt; + fillNameIfAbsent(...)&lt;br&gt;→ AccountHolding [table: account_holding]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1920" y="730" width="400" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="trA7" value="&lt;i&gt;currentPrice vient du ticker WebSocket TR (déjà fourni), pas de PriceService ici — Phase 4 re-fetche via getPriceEur(asset) à l&#39;affichage&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1920" y="850" width="400" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="trHB" value="CSV fallback — soldes seulement" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1920" y="940" width="400" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="trB1" value="&lt;b&gt;TradeRepublicController.importCsv()&lt;/b&gt;&lt;br&gt;→ TradeRepublicSyncService.importCsv(file, memberId)&lt;br&gt;&lt;i&gt;parse name,type,balance ; externalId = tr_csv_ + nom slugifié&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1920" y="980" width="400" height="100" as="geometry"/>
