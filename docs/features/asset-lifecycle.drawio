                </mxCell>
                <mxCell id="nf1" value="&lt;b&gt;AssetController&lt;/b&gt; (/api/assets)&lt;br&gt;GET / → listAll()&lt;br&gt;GET /{symbol}/candidates → previewResolution()&lt;br&gt;PUT /{symbol}/mapping → setManualMapping / applyMappings / markWorthless&lt;br&gt;DELETE /{symbol} → clearMapping()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
