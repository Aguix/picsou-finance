                </mxCell>
                <mxCell id="nc1" value="&lt;b&gt;Déclencheur Wallet Sync&lt;/b&gt;&lt;br&gt;WalletSyncService.addWallet()→sync() (à la demande)&lt;br&gt;ou SchedulerService.dailyBankSync() (cron 8h) → resyncAll()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
