                </mxCell>
                <mxCell id="ndb1" value="&lt;b&gt;financial_asset&lt;/b&gt;&lt;br&gt;id, symbol, status [PENDING|USER|WORTHLESS], coingecko_id, name, last_eur_value, price_synced_at" style="shape=cylinder;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
