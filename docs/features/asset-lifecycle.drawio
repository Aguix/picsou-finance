                <mxCell id="n3" value="&lt;b&gt;CoinGeckoPriceProvider.searchBySymbol(ticker)&lt;/b&gt;&lt;br&gt;&lt;i&gt;GET /search → CoinCandidate[]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="680" y="60" width="260" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="&lt;b&gt;FinancialAssetService.pickDominant(candidates)&lt;/b&gt;&lt;br&gt;&lt;i&gt;1 seul match → auto ; sinon dominance ×5 sur le rang market-cap ; sinon ambigu → reste PENDING&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
