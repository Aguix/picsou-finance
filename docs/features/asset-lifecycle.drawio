                </mxCell>
                <mxCell id="n1" value="&lt;b&gt;CryptoImportService.preview(file, memberId)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Parse le CSV → ParsedCryptoTx, cache par fileToken&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="60" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="&lt;b&gt;FinancialAssetService.previewResolutions(tickers)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Pour chaque ticker non USER/WORTHLESS → candidats (lecture seule, rien n&#39;est persisté)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="360" y="60" width="280" height="100" as="geometry"/>
